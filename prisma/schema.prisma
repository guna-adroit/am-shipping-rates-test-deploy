generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                   String    @id
  shop                 String
  state                String
  isOnline             Boolean   @default(false)
  scope                String?
  expires              DateTime?
  accessToken          String
  userId               BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner         Boolean   @default(false)
  locale               String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

// "Zone" = "Scenario" in the UI.
// zipCodes is retained for backward compatibility but scenarios use conditions for matching.
model Zone {
  id         String   @id
  shopDomain String
  name       String
  zipCodes   String   @default("") @db.Text
  // JSON: { logic: "all"|"any"|"none", rules: [{ id, category, attribute, operator, value, value2 }] }
  conditions String?  @db.Text
  isFallback Boolean  @default(false)
  status     String   @default("enabled")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rates      Rate[]
  liveCarrierRates LiveCarrierRate[]

  @@index([shopDomain])
}

model Rate {
  id          String   @id
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // "price" = Cart Total, "weight" = Cart Weight (legacy + current)
  type        String   @default("price")
  // "fixed" = dollar amount, "percentage" = % of cart total
  valueType   String   @default("fixed")
  // Optional link to a Shopify DeliveryProfile
  profileId   String?
  profileName String?
  status      String   @default("enabled")  // "enabled" | "disabled"
  minValue    Float    @default(0)
  maxValue    Float?
  price            Float    @default(0)
  minDeliveryDays  Int?                   // minimum delivery days shown at checkout
  maxDeliveryDays  Int?                   // maximum delivery days shown at checkout
  createdAt        DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId])
}

model CarrierService {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  serviceId   String
  callbackUrl String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Stores merchant-entered API credentials for a live carrier (FedEx, UPS, etc.)
// One row per shop + carrier. `credentials` is a JSON blob whose shape depends
// on the carrier (see app/carriers/definitions.js).
model CarrierCredential {
  id           String   @id @default(cuid())
  shopDomain   String
  carrierKey   String   // "fedex" | "ups" | "dhl_express" | "usps" | "canada_post" | "sendle" | "auspost_eparcel" | "auspost_pac"
  credentials  String   @db.Text // JSON string
  status       String   @default("unverified") // "unverified" | "verified" | "failed"
  lastSyncedAt DateTime?
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopDomain, carrierKey])
  @@index([shopDomain])
}

// A "Live carrier" rate config attached to a Zone/Scenario.
// Unlike Rate (fixed/tiered), this calls out to the carrier's API at checkout
// to fetch real-time rates, falling back to the configured flat fallback rate
// if the carrier call fails or times out.
model LiveCarrierRate {
  id          String   @id @default(cuid())
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String   // internal reference name
  notes       String?  @db.Text
  status      String   @default("enabled") // "enabled" | "disabled"
  carrierKey  String
  shippingLocation String @default("shopify_location")
  // JSON array of selected service codes, e.g. ["FEDEX_GROUND","FEDEX_2_DAY"]
  services    String   @default("[]") @db.Text
  packagingMethod      String @default("cart_attributes") // "cart_attributes" | "per_product" | "ai"
  packageSplittingRule String @default("cart_quantity")
  productFilter        String @default("all_products")
  // JSON array of packages: [{ id, length, width, height, unit, maxWeight, weightUnit }]
  packages    String   @default("[]") @db.Text
  fallbackName        String  @default("Flat rate")
  fallbackDescription String?
  fallbackType         String  @default("fixed") // "fixed"
  fallbackRate         Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId])
}
